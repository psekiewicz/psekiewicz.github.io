<?xml version="1.0" encoding="utf-8"?>
<!-- Not a <merge>: this frame is the view the activity repaints in the page's
     current background colour, so the system bars sitting over it match the
     page, and it is what the insets controller is anchored to. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Stands in for the page whenever there is nothing to show: no connection,
         or a WebView too old to run the site. -->
    <LinearLayout
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="?android:attr/windowBackground"
        android:visibility="gone">

        <TextView
            android:id="@+id/message_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/offline_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/message_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_body"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary" />

        <Button
            android:id="@+id/message_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/offline_retry" />

        <!-- Only used by the out-of-date-WebView screen, whose version check is
             a judgement call: this is the way past it if the guess is wrong. -->
        <Button
            android:id="@+id/message_secondary"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:text="@string/webview_old_continue" />
    </LinearLayout>

    <!-- Where a fullscreened <video> or YouTube embed gets re-parented; it sits
         above everything and deliberately ignores the window insets so the
         video really does fill the screen. -->
    <FrameLayout
        android:id="@+id/fullscreen_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone" />
</FrameLayout>
