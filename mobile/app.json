{
  "expo": {
    "name": "Showcase",
    "slug": "showcase",
    "version": "1.1.1",
    "orientation": "portrait",
    "scheme": "showcase",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "backgroundColor": "#c67139",
    "splash": {
      "image": "./assets/splash-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#c67139"
    },
    "android": {
      "package": "io.github.psekiewicz.showcase",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0ea5e9"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "SEND",
          "category": [
            "DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-video",
      "expo-system-ui",
      "./plugins/withReleaseSigning",
      "./plugins/withCrashLog",
      "./plugins/withShareIntent",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#f97316"
        }
      ]
    ]
  }
}
